{
  "name": "kujo-intake",
  "version": "0.1.0",
  "description": "Local-first source-agnostic business intake for the Kujo ecosystem.",
  "type": "module",
  "private": true,
  "author": {
    "name": "Robert DeVore",
    "email": "deviodigital@gmail.com"
  },
  "homepage": "https://github.com/kujolang/intake#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/kujolang/intake.git"
  },
  "bugs": {
    "url": "https://github.com/kujolang/intake/issues"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "!docs/audits/artifacts/**/*.log",
    "scripts/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "intake": "bin/intake.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "smoke": "node tests/smoke.mjs",
    "lint": "node --check bin/intake.js && find src tests scripts -name '*.js' -o -name '*.mjs' | xargs -n1 node --check",
    "verify": "npm run lint && npm run docs:links && npm test && npm run smoke && node bin/intake.js eval run && npm run bench:gate && npm audit --audit-level=high",
    "bench": "node scripts/bench.mjs",
    "bench:logs": "node scripts/bench-logs.mjs",
    "bench:gate": "node scripts/bench-threshold.mjs",
    "release:check": "npm run verify && node bin/intake.js shipcheck && node bin/intake.js doctor --json && node scripts/check-package.mjs",
    "intake": "node bin/intake.js",
    "test:browser": "node scripts/browser-test.mjs",
    "verify:live:email": "node scripts/verify-live.mjs --email",
    "docs:links": "node scripts/check-doc-links.mjs"
  },
  "dependencies": {
    "@tabler/icons": "^3.44.0",
    "imapflow": "^1.0.191",
    "mailparser": "^3.7.4",
    "nodemailer": "^10.0.13"
  },
  "keywords": [
    "kujo",
    "intake",
    "local-first",
    "agents",
    "workflow"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
