                  "startLine": 58
                }
              }
            }
          ],
          "message": {
            "text": "Secret-free output omits supported inline secret fields\n\nsanitizeSource masks token/api_token but not supported config.signing_secret. Default backup exclusions skip .env and secrets directories but copy sources.json verbatim, including supported inline token, api_token and signing_secret.\n\nSeverity: medium\n\nCategory: Data integrity\n\nWeaknesses: CWE-200\n\nRemediation:\nSanitize all supported inline credential fields in source output and secret-excluding backups, leaving reference fields intact; test preservation under explicit includeSecrets."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:bd79c628004afa3b5dbd548b55f816cd0ea4c7817b766e3beec80dba172078e2",
            "primaryLocationLineHash": "4e37bb09bb236543:1"
          },
          "properties": {
