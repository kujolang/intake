                  "uri": "src/rules.js"
                },
                "region": {
                  "endLine": 81,
                  "startLine": 55
                }
              }
            }
          ],
          "message": {
            "text": "Proposed rules are active before approval\n\nrules propose saves a rule with status proposed; applyRules iterates it without checking status. The separate rules approve command has no effect on eligibility.\n\nSeverity: medium\n\nCategory: Authorization\n\nWeaknesses: CWE-863\n\nRemediation:\nSkip explicitly nonapproved rules while preserving existing legacy rules with no status."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:f9464b3babf2610115b20cbe677663d7801d9beea25280c922c2d0effef246ab",
            "primaryLocationLineHash": "d3dcf5d56ef3a730:1"
          },
