              },
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/policy.js"
                },
                "region": {
                  "endLine": 96,
                  "startLine": 46
                }
              }
            }
          ],
          "message": {
            "text": "Concurrent action runs can duplicate outbound side effects\n\nEach run reads status, performs external execution, and only then saves executed. Two concurrent requests can both read approved and send/comment. Automatic budget counters use read-modify-write after execution and can similarly overrun caps.\n\nSeverity: medium\n\nCategory: Data integrity\n\nWeaknesses: CWE-362\n\nRemediation:\nSerialize execution and budget reservations per store across supported processes, re-read status under lock, and explicitly handle crash ambiguity without claiming exactly-once network delivery."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:8c032256d230fb10e082067adf99ab986f8ff74ef982f45b8a9c84328fb3a52d",
            "primaryLocationLineHash": "aa079dbef9729c90:1"
          },
          "properties": {
            "category": "data-integrity",
            "confidence": "high",
            "findingId": "csf_3a93d0493cfd0b5acf141184",
            "occurrenceId": "occ_e3e4859b3965902f8ad61374",
            "severity": "medium"
          },
          "ruleId": "intake.sec-08",
          "ruleIndex": 7
        },
        {
          "level": "warning",
          "locations": [
            {
              "message": {
                "text": "root_control"
              },
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/adapters/file.js"
                },
                "region": {
                  "endLine": 38,
                  "startLine": 17
                }
              }
            }
          ],
          "message": {
            "text": "File-drop symlinks cross the inbound filesystem boundary\n\nsyncFileSource uses stat, which follows symlinks, then readFile. A drop-folder entry named with a supported extension can point outside the folder and be imported as inbound content.\n\nSeverity: medium\n\nCategory: Data integrity\n\nWeaknesses: CWE-59\n\nRemediation:\nReject symlink entries and use no-follow file handles with regular-file checks; bound file size before buffering."
          },
          "partialFingerprints": {
            "codexSecurity/v1": "codex-security/v1:sha256:c8630657bd31a2fdeeb3398447ac91340ee733a0620221ce5dbf64b1f9f984cc",
            "primaryLocationLineHash": "b65a74fc267c6c79:1"
